# Placeholders only. Copy to .env (gitignored) and fill in; `python -m backend.serve` loads it. Never commit real keys.
PHISHTANK_USERNAME=
PHISHTANK_APP_KEY=
# URLhaus: free Auth-Key from https://auth.abuse.ch/ (sent as the Auth-Key header to https://urlhaus-api.abuse.ch/v1/url/)
URLHAUS_AUTH_KEY=
# Google Safe Browsing Lookup API v4: API key from a Google Cloud project with the "Safe Browsing API" enabled
# (non-commercial use only; commercial use needs Google Web Risk). Sent as ?key= to safebrowsing.googleapis.com only.
GOOGLE_SAFE_BROWSING_KEY=
# local OpenPhish snapshot older than this many hours: matches are reported as 'unverified'
OPENPHISH_STALE_HOURS=24
TI_TIMEOUT_SECONDS=5
TI_CACHE_TTL_SECONDS=900
# set to 1 to run tests/test_live_ti.py against the real services
WRA_LIVE_TESTS=0
